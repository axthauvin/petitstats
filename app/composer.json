{
    "name": "axthauvin/petitstats",
    "description": "Minimal, GDPR-friendly, self-hosted web analytics powered by PHP with SQLite, MySQL, or MariaDB",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Axel Thauvin"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-pdo_sqlite": "*",
        "ext-sqlite3": "*",
        "delight-im/auth": "^9.0",
        "maxmind-db/reader": "^1.14"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Petitstats\\": "src/"
        },
        "files": [
            "src/Updates/guard.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Petitstats\\Tests\\": "tests/php/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.1.0"
        }
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php ../scripts/build-docs.php",
            "php -S localhost:8080 -t . ../scripts/dev-router.php"
        ],
        "cs:check": "php-cs-fixer fix --config=../.php-cs-fixer.dist.php --dry-run --diff --ansi",
        "cs:fix": "php-cs-fixer fix --config=../.php-cs-fixer.dist.php",
        "analyse": "phpstan analyse --memory-limit=1G",
        "analyse:all": "phpstan analyse --memory-limit=1G -c phpstan.base.neon",
        "analyse:baseline": "phpstan analyse --memory-limit=1G --generate-baseline",
        "test": "phpunit"
    }
}
