# Petitstats Apache Configuration
Options -Indexes

# The tracking script changes independently of the sites embedding it. Always
# revalidate it so an existing snippet cannot keep sending an outdated payload.
<IfModule mod_headers.c>
    <FilesMatch "^(petitstats|minilytics)\.js$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# The site root serves a static index.html when a landing page is deployed next
# to the app, and otherwise falls back to index.php, which opens the dashboard.
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # PHP running as CGI/FastCGI does not receive the Authorization header,
    # which carries the tokens of the MCP endpoint.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Application code and Composer files are never meant to be requested directly.
    RewriteRule ^(vendor|src|templates|bin|tests)(/|$) - [F,L]
    RewriteRule ^composer\.(json|lock)$ - [F,L]
</IfModule>

# Protect sensitive files
<FilesMatch "\.(db|db-wal|db-shm|json|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Allow large file uploads for ZIP imports (up to 128MB)
<IfModule mod_php.c>
    php_value upload_max_filesize 128M
    php_value post_max_size 128M
    php_value memory_limit 256M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 128M
    php_value post_max_size 128M
    php_value memory_limit 256M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>
